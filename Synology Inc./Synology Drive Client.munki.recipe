<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Comment</key>
	<string>Created with Recipe Robot v2.5.0 (https://github.com/homebysix/recipe-robot)</string>
	<key>Description</key>
	<string>Downloads the latest version of Synology Drive Client and imports it into Munki.</string>
	<key>Identifier</key>
	<string>com.supportplan.munki.SynologyDriveClient</string>
	<key>Input</key>
	<dict>
		<key>MUNKI_REPO_SUBDIR</key>
		<string>apps/%NAME%</string>
		<key>NAME</key>
		<string>Synology Drive Client</string>
		<key>pkginfo</key>
		<dict>
			<key>blocking_applications</key>
			<array>
				<string>Synology Drive Client.app</string>
				<string>Remove Synology Drive Client.app</string>
			</array>
			<key>catalogs</key>
			<array>
				<string>testing</string>
			</array>
			<key>description</key>
			<string>Private cloud for sharing, synchronizing, and managing files.</string>
			<key>developer</key>
			<string>Synology Inc.</string>
			<key>display_name</key>
			<string>Synology Drive Client</string>
			<key>name</key>
			<string>%NAME%</string>
			<key>unattended_install</key>
			<true/>
		</dict>
	</dict>
	<key>MinimumVersion</key>
	<string>2.3</string>
	<key>ParentRecipe</key>
	<string>com.github.ahousseini-recipes.download.SynologyDriveClient</string>
	<key>Process</key>
	<array>
	    <dict>
	        <key>Processor</key>
	        <string>PkgCopier</string>
	        <key>Arguments</key>
	        <dict>
	            <key>source_pkg</key>
	            <string>%pathname%/Install Synology Drive Client.pkg</string>
	            <key>pkg_path</key>
	            <string>%RECIPE_CACHE_DIR%/%NAME%.pkg</string>
	        </dict>
	    </dict>
	    <dict>
	        <key>Processor</key>
	        <string>MunkiImporter</string>
	        <key>Arguments</key>
	        <dict>
	            <key>pkg_path</key>
	            <string>%pkg_path%</string>
	            <key>repo_subdirectory</key>
	            <string>%MUNKI_REPO_SUBDIR%</string>
	        </dict>
	    </dict>
	</array>
</dict>
</plist>
